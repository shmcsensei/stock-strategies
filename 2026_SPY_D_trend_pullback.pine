//@version=6
// Apply to a regular-candle SPY chart on the 1D timeframe.
// Long only. This is a research strategy, not a return guarantee.
strategy(
     title = "Conservative SPY Trend Pullback (daily)",
     overlay = true,
     initial_capital = 10000,
     currency = currency.USD,
     pyramiding = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0.01, // 1 bp per side; increase to match the broker.
     slippage = 1,            // One tick on market and stop orders.
     margin_long = 100,
     margin_short = 100,
     calc_on_every_tick = false,
     process_orders_on_close = false)

if not timeframe.isdaily
    runtime.error("Apply this strategy to a 1D SPY chart using standard candles.")

// Keep risk modest. The share count is the smaller of the risk-based and cash-only sizes.
riskPercent = input.float(0.50, "Equity risk per trade (%)", minval = 0.10, maxval = 1.00, step = 0.05)
stopAtrMult = input.float(2.5, "Initial stop (ATR)", minval = 1.0, step = 0.1)
trailAtrMult = input.float(3.0, "Trailing stop (ATR)", minval = 1.0, step = 0.1)
startDate = input.time(timestamp("01 Jan 2005 00:00 +0000"), "Start date")

// Daily trend and momentum inputs use only the completed daily bar.
ema20 = ta.ema(close, 20)
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
atr = ta.atr(14)
rsi = ta.rsi(close, 14)

// These are last week's confirmed values. The one-bar offset plus lookahead_on is
// deliberately used to keep the weekly filter identical in historical and live data.
[weeklyClose, weeklySma40] = request.security(
     syminfo.tickerid,
     "W",
     [close[1], ta.sma(close, 40)[1]],
     lookahead = barmerge.lookahead_on)

weeklyTrend = weeklyClose > weeklySma40
dailyTrend = close > sma200 and sma50 > sma200 and sma200 > sma200[20]
pullbackOccurred = ta.lowest(low, 10)[1] <= ema20[1]
breakoutLevel = ta.highest(high, 5)[1]
recoveryBreakout = close > breakoutLevel and close[1] <= breakoutLevel[1]
momentumOK = rsi > 52 and rsi < 70

inPosition = strategy.position_size > 0
entrySignal = time >= startDate and not inPosition and weeklyTrend and dailyTrend and pullbackOccurred and recoveryBreakout and momentumOK

// Size from a fixed fraction of current equity, but never borrow or average down.
riskPerShare = atr * stopAtrMult
riskShares = riskPerShare > 0 ? math.floor(strategy.equity * riskPercent / 100 / riskPerShare) : 0
cashShares = math.floor(strategy.equity / close)
quantity = math.min(riskShares, cashShares)

var float signalAtr = na
var float stopPrice = na
var float peakHigh = na

if entrySignal and quantity >= 1
    signalAtr := atr
    strategy.entry("Long", strategy.long, qty = quantity, comment = "Trend pullback recovery")
    // Attach a stop while the entry is pending; it is refined from the actual fill below.
    strategy.exit("Protective stop", from_entry = "Long", stop = close - signalAtr * stopAtrMult)

newLong = inPosition and strategy.position_size[1] <= 0
if newLong
    peakHigh := high
    stopPrice := strategy.position_avg_price - signalAtr * stopAtrMult

if inPosition
    peakHigh := math.max(nz(peakHigh, high), high)
    initialStop = strategy.position_avg_price - signalAtr * stopAtrMult
    trailingStop = peakHigh - atr * trailAtrMult
    stopPrice := math.max(nz(stopPrice, initialStop), initialStop, trailingStop)
    strategy.exit("Protective stop", from_entry = "Long", stop = stopPrice)

    // A confirmed loss of the trend exits at the next available market price.
    if close < sma50 or weeklyClose < weeklySma40
        strategy.close("Long", comment = "Trend exit")
else if not entrySignal
    signalAtr := na
    stopPrice := na
    peakHigh := na

plot(ema20, "20-day EMA", color = color.orange)
plot(sma50, "50-day SMA", color = color.blue)
plot(sma200, "200-day SMA", color = color.purple, linewidth = 2)
plot(inPosition ? stopPrice : na, "Active stop", color = color.red, style = plot.style_linebr)
plotshape(entrySignal and quantity >= 1, title = "Entry signal", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.tiny)
