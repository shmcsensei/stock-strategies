//@version=5
strategy("UVXY 1 Day",initial_capital=56,overlay=true, pyramiding = 100)

// UVXY 1 Day, 100% Profitable, 34% Profit


// VIX data
vix = request.security(symbol="VIX", timeframe="D", expression = close)
vix_high = request.security(symbol="VIX", timeframe="D", expression = high)
vix_low = request.security(symbol="VIX", timeframe="D", expression = low)
vix_length = 330
vix_ma = ta.ema(close, 14)
vix_basis_local = ta.ema(vix_ma, vix_length)
vix_basis = request.security(symbol="VIX", timeframe="D", expression = vix_basis_local)

vix_upper_dev_local = 1.60 * ta.stdev(close, vix_length)
vix_upper_dev = request.security(symbol="VIX", timeframe="D", expression = vix_upper_dev_local)

vix_lower_dev_local = 0.65 * ta.stdev(close, vix_length)
vix_lower_dev = request.security(symbol="VIX", timeframe="D", expression = vix_lower_dev_local)

vix_upper = vix_basis + vix_upper_dev
vix_lower = vix_basis - vix_lower_dev
// plot(vix)
// plot(vix_basis, "VIX Basis", color=#FF6D00)
// plot(vix_upper, "VIX Upper", color=#2962FF)
// plot(vix_lower, "VIX Lower", color=#2962FF)

vix_overbought = vix > vix_upper or vix_high > vix_upper
// vix_oversold = vix < vix_lower or vix_low < vix_lower
vix_oversold = vix < vix_lower

color bg = na
if vix_oversold
    bg := #15ff001e
if vix_overbought
    bg := #ffa6001e

bgcolor(color=bg)

// True Range 14 EMA
tr = ta.ema(ta.tr(true), 14)


long_buy = vix_oversold
long_sell = vix_overbought


plotchar(long_buy, "go long", "L", location.top, size = size.auto, color=color.green)
plotchar(long_sell, "go short", "S", location.top, size = size.auto, color=color.red)


session = not na(time(timeframe.period, "0930-1600"))  and time > timestamp(2021, 01, 01, 09, 30)
session_active = not na(time(timeframe.period, "1000-1200"))
session_end = not na(time(timeframe.period, "1545-1600"))

session_orders = 0
if session
    session_orders := session_orders[1]

long_count = 0
long_count := long_count[1]

move_percentage_step = 0.01

strategy_price = 0.0
strategy_price := strategy_price[1]

position_bars = 0
position_bars := position_bars[1]


float order_limit = na
order_limit := order_limit[1]
if strategy.position_size > 0
    position_bars += 1

position_size = 0.0
position_size := position_size[1]

if session

    if position_size < strategy.position_size
        position_size := strategy.position_size
        position_bars := 0
        session_orders += 1

    if session_orders < 100
        if long_count == 0 and long_buy
            long_count += 1
        if long_count == 1
            long_count += 1
            strategy.order("enter long1", strategy.long, comment="long1", qty=1)
        if strategy.position_size > 0 and strategy.position_size < 16
            session_orders += 1
            order_size = strategy.position_size
            order_limit := strategy.position_avg_price-tr
            strategy.order("enter long"+ str.tostring(order_size), strategy.long, comment="long"+ str.tostring(order_size), qty=order_size, limit = order_limit)
        
    if long_sell
        strategy.cancel_all()
        strategy.close_all()
        long_count := 0
        session_orders := 0
        order_limit := na
        position_bars := 0
else
    strategy.cancel_all()

        

plot(strategy.position_size > 0 ? strategy.position_avg_price: close, color = strategy.position_size > 0 ? color.yellow: na, title="Average Price")
plot(not na(order_limit) ? order_limit : close , color = not na(order_limit)  ? color.rgb(250, 249, 179, 25): na, title="Order Price")


