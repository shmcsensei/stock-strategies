//@version=5
strategy("FAS Bollinger Band Strategy 2hr",initial_capital=1800,overlay=true, pyramiding = 11)

// 95% profitable, 54% profit, profit factor 363

// Bollinger Bands
length = input.int(100, minval=1)
src = input(close, title="Source")
mult = input.float(1.5, minval=0.001, maxval=50, title="StdDev")
basis = ta.ema(src, length)
dev = mult * ta.stdev(src, length)
upper = basis + dev
lower = basis - dev
offset = input.int(0, "Offset", minval = -500, maxval = 500)
plot(basis, "Basis", color=#FF6D00, offset = offset)
p1 = plot(upper, "Upper", color=#2962FF, offset = offset)
p2 = plot(lower, "Lower", color=#2962FF, offset = offset)
fill(p1, p2, title = "Background", color=color.rgb(33, 150, 243, 95))

// Stochastic
periodK = input.int(40, title="%K Length", minval=1)
smoothK = input.int(3, title="%K Smoothing", minval=1)
periodD = input.int(3, title="%D Smoothing", minval=1)
k = ta.sma(ta.stoch(close, high, low, periodK), smoothK)
d = ta.sma(k, periodD)
// plot(k, title="%K", color=#2962FF)
// plot(d, title="%D", color=#FF6D00)
// h0 = hline(80, "Upper Band", color=#787B86)
// hline(50, "Middle Band", color=color.new(#787B86, 50))
// h1 = hline(20, "Lower Band", color=#787B86)
// fill(h0, h1, color=color.rgb(33, 150, 243, 90), title="Background")

go_short = (close > upper or open > upper) 
go_long = (close < lower or open < lower) and d <= 15

session = not na(time(timeframe.period, "0830-1600"))  and time > timestamp(2021, 01, 01, 09, 30)
session_active = not na(time(timeframe.period, "1000-1200"))
session_end = not na(time(timeframe.period, "1545-1600"))

session_orders = 0
if session
    session_orders := session_orders[1]

long_count = 0
long_count := long_count[1]

move_percentage_max = 0.30
move_percentage_step = move_percentage_max / 9.0

strategy_price = 0.0
strategy_price := strategy_price[1]

if session
    if session_orders < 1
        if long_count == 0 and go_long
            long_count += 1
        if long_count == 1
            session_orders += 1
            long_count += 1
            strategy_price := close
            strategy.order("enter long1", strategy.long, comment="long1", qty=1, limit = close)
        if strategy.position_size == 1
            session_orders += 1
            strategy.order("enter long2", strategy.long, comment="long2", qty=1, limit = strategy_price*(1-(move_percentage_step*1)))
        if strategy.position_size == 2
            session_orders += 1
            strategy.order("enter long3", strategy.long, comment="long3", qty=2, limit = strategy_price*(1-(move_percentage_step*2)))
        if strategy.position_size == 4
            session_orders += 1
            strategy.order("enter long4", strategy.long, comment="long4", qty=4, limit = strategy_price*(1-(move_percentage_step*3)))
        if strategy.position_size == 8
            session_orders += 1
            strategy.order("enter long5", strategy.long, comment="long5", qty=8, limit = strategy_price*(1-(move_percentage_step*4)))
        if strategy.position_size == 16
            session_orders += 1
            strategy.order("enter long6", strategy.long, comment="long6", qty=16, limit = strategy_price*(1-(move_percentage_step*5)))
        if strategy.position_size == 32
            session_orders += 1
            strategy.order("enter long7", strategy.long, comment="long7", qty=32, limit = strategy_price*(1-(move_percentage_step*6)))
        if strategy.position_size == 64
            session_orders += 1
            strategy.order("enter long8", strategy.long, comment="long8", qty=64, limit = strategy_price*(1-(move_percentage_step*7)))
        if strategy.position_size == 128
            session_orders += 1
            strategy.order("enter long9", strategy.long, comment="long9", qty=128, limit = strategy_price*(1-(move_percentage_step*8)))
        if strategy.position_size == 256
            session_orders += 1
            strategy.order("enter long10", strategy.long, comment="long10", qty=256, limit = strategy_price*(1-(move_percentage_step*9)))
    if go_short or close > strategy.position_avg_price*1.1
        strategy.cancel_all()
        strategy.close_all()
        long_count := 0
        
        

plot(strategy.position_size > 0 ? strategy.position_avg_price: close, color = strategy.position_size > 0 ? color.yellow: na)