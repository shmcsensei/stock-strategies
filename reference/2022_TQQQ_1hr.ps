//@version=5
strategy("TQQQ Bollinger Band Strategy",initial_capital=500,overlay=true, pyramiding = 11)

// Returns 80% profitable with 41% profit during test.

// Bollinger Bands
length = input.int(20, minval=1)
src = input(low, title="Source")
mult = input.float(1.7, minval=0.001, maxval=50, title="StdDev")
basis = ta.sma(src, length)
dev = mult * ta.stdev(src, length)
upper = basis + dev
lower = basis - dev
offset = input.int(0, "Offset", minval = -500, maxval = 500)
plot(basis, "Basis", color=#FF6D00, offset = offset)
p1 = plot(upper, "Upper", color=#2962FF, offset = offset)
p2 = plot(lower, "Lower", color=#2962FF, offset = offset)
fill(p1, p2, title = "Background", color=color.rgb(33, 150, 243, 95))

// Stochastic
periodK = input.int(50, title="%K Length", minval=1)
smoothK = input.int(10, title="%K Smoothing", minval=1)
periodD = input.int(3, title="%D Smoothing", minval=1)
k = ta.sma(ta.stoch(close, high, low, periodK), smoothK)
d = ta.sma(k, periodD)
// plot(k, title="%K", color=#2962FF)
// plot(d, title="%D", color=#FF6D00)
// h0 = hline(80, "Upper Band", color=#787B86)
// hline(50, "Middle Band", color=color.new(#787B86, 50))
// h1 = hline(20, "Lower Band", color=#787B86)
// fill(h0, h1, color=color.rgb(33, 150, 243, 90), title="Background")

go_short = (close > upper or open > upper) 
go_long = (close < lower or open < lower) and d <= 15

session = not na(time(timeframe.period, "0830-1600"))  and time > timestamp(2021, 02, 01, 09, 30)
session_active = not na(time(timeframe.period, "1000-1200"))
session_end = not na(time(timeframe.period, "1545-1600"))

session_orders = 0
if session
    session_orders := session_orders[1]

long_count = 0
long_count := long_count[1]


if session
    if session_orders < 1
        if long_count == 0 and go_long
            long_count += 1
        if long_count == 1
            session_orders += 1
            long_count += 1
            strategy.order("enter long1", strategy.long, comment="long1", qty=1, limit = close)
            strategy.order("enter long2", strategy.long, comment="long2", qty=2, limit = close*0.96)
            strategy.order("enter long3", strategy.long, comment="long3", qty=4, limit = close*0.92)
            strategy.order("enter long4", strategy.long, comment="long4", qty=8, limit = close*0.88)
            strategy.order("enter long5", strategy.long, comment="long5", qty=16, limit = close*0.84)
            strategy.order("enter long6", strategy.long, comment="long6", qty=32, limit = close*0.80)
            strategy.order("enter long7", strategy.long, comment="long7", qty=64, limit = close*0.76)
            strategy.order("enter long8", strategy.long, comment="long8", qty=128, limit = close*0.72)
            strategy.order("enter long9", strategy.long, comment="long9", qty=256, limit = close*0.68)
    if go_short
        strategy.cancel_all()
        strategy.close_all()
        long_count := 0
        
        

plot(strategy.position_size > 0 ? strategy.position_avg_price: close, color = strategy.position_size > 0 ? color.yellow: na)